// decompression: sparse u1 stream to scaled i16 weights.

static values: [i64; 8];

#[partition_dim_array([0])]
#[partition_factor_array([4])]
#[partition_cyclic_array([1])]
static dense_values: [i8; 32];

#[partition_dim_array([0])]
#[partition_factor_array([4])]
#[partition_cyclic_array([1])]
static decompressed_weights: [i16; 32];

static vidx: u32 = 0;

#[opcode(7'b0001011)]
#[funct7(7'b0000101)]
rtype deca_decompress_u1(rs1: u5, rs2: u5, rd: u5) {
    let base_addr: u32 = _irf[rs1];
    let out_addr: u32 = _irf[rs2];
    vidx = 0;

    values[0 +: ] = _mem[base_addr +: 8];
    let bitmask: u32 = _mem[base_addr + 64];
    let global_scale: i16 = _mem[base_addr + 68];

    // Stage 1: unpack sparse values according to the 32-bit bitmask.
    with idx: u8 = (0, idx_) do {
        let mask_byte: u8 = sel {
            idx < 2: bitmask[7:0],
            idx < 4: bitmask[15:8],
            idx < 6: bitmask[23:16],
            idx >= 6: bitmask[31:24],
        };

        [[unroll(4)]]
        with bit_idx: u8 = (0, bit_idx_) do {
            let bit_pos: u8 = idx[0:0] * 4 + bit_idx;
            let bit_shifted: u8 = mask_byte >> bit_pos;
            let is_nonzero: u1 = bit_shifted[0:0];

            let zero_i8: i8 = 0;
            let value_idx: u32 = vidx >> 3;       // vidx / 8
            let value_offset: u32 = vidx & 7;     // vidx % 8

            let val_double_word: i64 = values[value_idx];
            let val: i8 = (val_double_word >> (value_offset * 8))[7:0];

            let elem_idx: u8 = idx * 4 + bit_idx;
            dense_values[elem_idx] = if is_nonzero { val } else { zero_i8 };

            vidx = vidx + (if is_nonzero {1} else {0});

            let bit_idx_: u8 = bit_idx + 1;
        } while (bit_idx_ < 4);

        let idx_: u8 = idx + 1;
    } while (idx_ < 8);

    // Stage 2: dequantize dense i8 values to i16.
    [[unroll(4)]]
    with idx: u8 = (0, idx_) do {
        let val: i8 = dense_values[idx];
        let val32: i32 = val;
        let global_scale32: i32 = global_scale;
        let mul_result: i32 = val32 * global_scale32;
        let dequant: i16 = (mul_result >> 8)[15:0];

        decompressed_weights[idx] = dequant;
        let idx_: u8 = idx + 1;
    } while (idx_ < 32);

    _mem[out_addr +: 64] = decompressed_weights[0 +: ];
    _irf[rd] = 0;
}

// GEMM 4x4: C = A x B, with partitioned 16-element matrix buffers.
#[partition_dim_array([0])]
#[partition_factor_array([4])]
#[partition_cyclic_array([1])]
static matrix_a: [i16; 16];

#[partition_dim_array([0])]
#[partition_factor_array([4])]
#[partition_cyclic_array([1])]
static matrix_b: [i16; 16];

#[partition_dim_array([0])]
#[partition_factor_array([4])]
#[partition_cyclic_array([1])]
static matrix_c: [i16; 16];

#[opcode(7'b0101011)]
#[funct7(7'b0111000)]
rtype gemm_4x4(rs1: u5, rs2: u5, rd: u5) {
    let addr_a: u32 = _irf[rs1];
    let addr_b: u32 = _irf[rs2];

    matrix_a[0 +: ] = _mem[addr_a +: 16];
    matrix_b[0 +: ] = _mem[addr_b +: 16];

    with i: u8 = (0, i_) do {
        [[unroll(4)]]
        with j: u8 = (0, j_) do {
            [[unroll(4)]]
            with k: u8 = (0, k_) acc: i16 = (0, acc_) do {
                let a_idx: u8 = i * 4 + k;
                let a_val: i16 = matrix_a[a_idx];

                let b_idx: u8 = k * 4 + j;
                let b_val: i16 = matrix_b[b_idx];

                let acc_: i16 = acc ^ (a_val & b_val);

                let k_: u8 = k + 1;
            } while (k_ < 4);

            let c_idx: u8 = i * 4 + j;
            matrix_c[c_idx] = acc;

            let j_: u8 = j + 1;
        } while (j_ < 4);

        let i_: u8 = i + 1;
    } while (i_ < 4);

    let write_addr: u32 = addr_b + 32;
    _mem[write_addr +: 16] = matrix_c[0 +: ];

    _irf[rd] = 0;
}

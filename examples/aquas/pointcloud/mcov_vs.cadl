#[partition_dim_array([0])]
#[partition_factor_array([2])]
#[partition_cyclic_array([1])]
static points_x: [i32; 16];

#[partition_dim_array([0])]
#[partition_factor_array([2])]
#[partition_cyclic_array([1])]
static points_y: [i32; 16];

#[partition_dim_array([0])]
#[partition_factor_array([2])]
#[partition_cyclic_array([1])]
static points_z: [i32; 16];

#[partition_dim_array([0])]
#[partition_factor_array([8])]
#[partition_cyclic_array([1])]
static cov_accum: [i32; 8];

#[opcode(7'b0101011)]
#[funct7(7'b0101011)]
rtype mcov_vs(rs1: u5, rs2: u5, rd: u5) {
  let points_addr: u32 = _irf[rs1];
  let out_addr: u32 = _irf[rs2];
  let cx: i32 = _mem[out_addr + 32];
  let cy: i32 = _mem[out_addr + 36];
  let cz: i32 = _mem[out_addr + 40];
  points_x[0 +: ] = _mem[points_addr +: 16];
  points_y[0 +: ] = _mem[points_addr + 64 +: 16];
  points_z[0 +: ] = _mem[points_addr + 128 +: 16];
  [[unroll(2)]]
  with i: u8 = (0, i_)
       c00: i32 = (0, c00_)
       c01: i32 = (0, c01_)
       c02: i32 = (0, c02_)
       c11: i32 = (0, c11_)
       c12: i32 = (0, c12_)
       c22: i32 = (0, c22_)
  do {
    let x: i32 = points_x[i];
    let y: i32 = points_y[i];
    let z: i32 = points_z[i];
    let dx: i32 = x - cx;
    let dy: i32 = y - cy;
    let dz: i32 = z - cz;
    let c00_: i32 = c00 + dx * dx;
    let c01_: i32 = c01 + dx * dy;
    let c02_: i32 = c02 + dx * dz;
    let c11_: i32 = c11 + dy * dy;
    let c12_: i32 = c12 + dy * dz;
    let c22_: i32 = c22 + dz * dz;
    let i_: u8 = i + 1;
  } while (i_ < 16);
  _mem[out_addr] = c00;
  _mem[out_addr + 4] = c01;
  _mem[out_addr + 8] = c02;
  _mem[out_addr + 12] = c11;
  _mem[out_addr + 16] = c12;
  _mem[out_addr + 20] = c22;
  _irf[rd] = 1;
}

{
  "name": "cadl",
  "displayName": "CADL (APS)",
  "description": "Syntax highlighting for APS Computer Architecture Description Language",
  "version": "0.1.0",
  "publisher": "aquas",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "keywords": ["cadl", "aps", "risc-v", "hardware"],
  "license": "MIT",
  "contributes": {
    "languages": [{
      "id": "cadl",
      "aliases": ["CADL", "cadl"],
      "extensions": [".cadl"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "cadl",
      "scopeName": "source.cadl",
      "path": "./syntaxes/cadl.tmLanguage.json"
    }]
  }
}
